# Nexus frontend environment variables
# Copy this file to .env.local for local development.
# In Railway, set these as environment variables in the service settings.

# ── API routing ────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL **must** be left empty (or not set at all) in every
# environment — development, staging, and production alike.
#
# Leaving it empty means the Vite build uses relative URLs for all API calls
# (/api/...) which are proxied by Nexus's built-in HTTP proxy to the correct
# backend.  Setting it to an absolute URL (e.g. https://my-api.railway.app)
# bakes that URL into the minified bundle, bypasses the proxy, and causes
# broken/undefined responses and silent JS crashes in production.
#
# server.js enforces this at startup and will exit(1) if the value is non-empty.
VITE_API_BASE_URL=

# ── Internal service targets (set in Railway Variables) ───────────────────────
# These are read by server.js at runtime (not baked into the frontend bundle).
# API_TARGET=https://your-api-service.up.railway.app
# GO_TARGET=https://your-go-service.up.railway.app
